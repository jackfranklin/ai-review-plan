{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist/ui",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true
  },
  "include": ["src/ui/**/*", "src/types/**/*"]
}
