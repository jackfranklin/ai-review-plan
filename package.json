{
  "name": "@jackfranklin/ai-review",
  "version": "0.2.0",
  "description": "CLI + local web UI for annotating AI-generated markdown plans",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackfranklin/ai-review-plan.git"
  },
  "keywords": [
    "cli",
    "ai",
    "review",
    "plan",
    "markdown",
    "annotation"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "ai-review": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev-plan": "tsx scripts/dev.ts",
    "dev-diff": "tsx scripts/dev.ts --diff",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsx scripts/build.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "ci": "npm run test && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "get-port": "^7.1.0",
    "marked": "^12.0.0",
    "mermaid": "^11.15.0",
    "open": "^10.1.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.21.5",
    "eslint": "^9.9.0",
    "husky": "^9.1.7",
    "lit": "^3.1.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.3.4",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^4.1.7"
  }
}
